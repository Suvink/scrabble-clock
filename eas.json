{
    "cli": {
        "version": ">= 0.48.2"
    },
    "build": {
        "preview": {
            "android": {
                "buildType": "apk"
            }
        },
        "preview2": {
            "android": {
                "gradleCommand": ":app:assembleRelease"
            }
        },
        "preview3": {
            "developmentClient": true
        },
        "production": {
            "android": {
                "env": {
                    "APP_VARIANT": "Android"
                }
            },
            "ios": {
                "env": {
                    "APP_VARIANT": "iOS"
                }
            }
        }
    },
    "submit": {
        "production": {}
    }
}
